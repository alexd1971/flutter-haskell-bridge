cabal-version: 3.0
name: haskell-ffi
version: 0.1.0.0
license: BSD-3-Clause
build-type: Simple

library
  c-sources:
      cbits/haskell_runtime.c
  exposed-modules:
      Bridge.FFI
  hs-source-dirs:
      src
  default-language: Haskell2010
  build-depends:
      base >= 4.19 && < 4.22
    , haskell-ffi-th
    , haskell-lib
    , template-haskell
  ghc-options:
      -Wall
